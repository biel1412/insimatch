@page "/"
@inject ArmazenamentoService Armazenamento
@inject IJSRuntime JS
@inject CofreService Cofre
@implements IDisposable

<div class="app @(Apresentacao ? "modo-apresentacao" : "")" data-tema="@Temas[TemaIdx].Id" data-fundo="@Fundos[FundoIdx].Id" data-movimento="@(Movimento && Config.MostrarMovimento ? "on" : "off")"
     data-aba="@(AbaAtual.Personalizada is null ? AbaAtual.Id : "cliente")">
    <PapelDeParede Fundo="@Fundos[FundoIdx].Id" />

    @* Menu principal: dock vertical com indicador deslizante *@
    <nav class="dock" style="--ativo:@AbaIdx" aria-label="Abas">
        <div class="dock-logo" title="insiTalent">i<span>T</span></div>
        <div class="dock-itens">
            <span class="dock-indicador"></span>
            @foreach (var aba in Abas)
            {
                var id = aba.Id;
                var ativo = id == AbaAtual.Id;
                <button class="dock-item @(ativo ? "ativo" : "")" data-tip="@aba.Nome"
                        aria-current="@(ativo ? "page" : null)" @onclick="() => MudarAbaAsync(id)">
                    <span class="dock-ico"><IconeSvg Id="@aba.Icone" /></span>
                    <span class="dock-txt">@aba.Curto</span>
                </button>
            }
            @if (Config.MostrarNovaAba)
            {
                <button class="dock-item dock-mais" data-tip="Nova aba" aria-label="Nova aba" @onclick="AbrirCriacao">
                    <span class="dock-ico"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg></span>
                    <span class="dock-txt">Nova</span>
                </button>
            }
        </div>
        <button class="dock-cofre @(Cofre.Protegido ? "protegido" : "")"
                data-tip="@(Cofre.Protegido ? "Protegido com senha · clique para bloquear" : "Modo sigiloso · nada é salvo")"
                aria-label="Privacidade e dados" title="@(Cofre.Protegido ? "Protegido com senha · clique para bloquear" : "Modo sigiloso · nada é salvo")"
                @onclick="CofreCliqueAsync">
            @if (Cofre.Protegido)
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6z" /><path d="M9.5 12.5l1.8 1.8 3.4-3.6" /></svg>
            }
        </button>
        <button class="dock-config" data-tip="Configurações" aria-label="Configurações" title="Configurações" @onclick="() => { ConfigAberta = true; }">
            <IconeSvg Id="engrenagem" />
        </button>
    </nav>

    <CascadingValue Value="RelHost" IsFixed="true">
    <CascadingValue Name="Apresentacao" Value="Apresentacao">
    @if (!Pronto)
    {
        <div class="vazio">Carregando…</div>
    }
    else if (AbaAtual.Personalizada is { } p)
    {
        @switch (p.Tipo)
        {
            case "slides":
                <SlidesAba @key="p.Id" Chave="@p.ChaveDados" Contexto="@(new ContextoPainel(p.Nome, p.Singular, true))"
                           OnConfigurar="() => AbrirEdicao(p)"
                           Apresentacao="Apresentacao" Modelo="@ModeloAtual.Id" Ferramentas="Ferramentas" />
                break;
            case "fluxo":
                <FluxoAba @key="p.Id" Chave="@p.ChaveDados" Contexto="@(new ContextoPainel(p.Nome, p.Singular, true))"
                          OnConfigurar="() => AbrirEdicao(p)"
                          Apresentacao="Apresentacao" Modelo="@ModeloAtual.Id" Ferramentas="Ferramentas" />
                break;
            default:
                <ClienteAba @key="p.Id" Chave="@p.ChaveDados" Contexto="@(new ContextoPainel(p.Nome, p.Singular, true))"
                            SementeExemplo="false" OnConfigurar="() => AbrirEdicao(p)"
                            Apresentacao="Apresentacao" Modelo="@ModeloAtual.Id" Ferramentas="Ferramentas" />
                break;
        }
    }
    else
    {
        @switch (AbaAtual.Id)
        {
            default:
                <IndividualAba @key="@("individual")" Apresentacao="Apresentacao" Modelo="@ModeloAtual.Id" Ferramentas="Ferramentas" />
                break;
        }
    }
    </CascadingValue>
    </CascadingValue>

    @if (RelatorioAberto is not null)
    {
        <RelatorioFolha D="RelatorioAberto" OnFechar="() => { RelatorioAberto = null; }" />
    }

    @if (IAAberta)
    {
        <IADialogo OnCriar="CriarAbaIAAsync" OnFechar="() => { IAAberta = false; }" />
    }

    @if (Cofre.PrivacidadeAberta)
    {
        <PrivacidadeDialogo />
    }

    @if (ConfigAberta)
    {
        <ConfigDialogo Atual="Config" Personalizadas="Personalizadas.Count" OnSalvar="SalvarConfigAsync" OnFechar="() => { ConfigAberta = false; }" />
    }

    @if (DialogoAberto)
    {
        <AbaDialogo Aba="Editando" OnSalvar="SalvarAbaAsync" OnExcluir="ExcluirAbaAsync" OnFechar="FecharDialogo" />
    }
</div>

@code {
    private record Aba(string Id, string Nome, string Curto, string Icone, Opcao[] Modelos, AbaPersonalizada? Personalizada = null);

    private static readonly Opcao[] ModelosPainel =
    {
        new("cartoes", "Cartões"), new("placar", "Placar"), new("foco", "Foco")
    };

    private static readonly Opcao[] ModelosSlides =
    {
        new("slide", "Slide"), new("rolagem", "Rolagem"), new("grade", "Visão geral")
    };

    private static readonly Opcao[] ModelosFluxo =
    {
        new("vertical", "Vertical"), new("horizontal", "Horizontal")
    };

    private static Opcao[] ModelosDe(AbaPersonalizada p) => p.Tipo switch
    {
        "slides" => ModelosSlides,
        "fluxo" => ModelosFluxo,
        _ => ModelosPainel
    };

    private static readonly Aba[] Fixas =
    {
        new("individual", "Resultado individual", "Individual", "pessoa", new Opcao[]
        {
            new("cartoes", "Cartões"), new("graficos", "Gráficos"), new("placar", "Placar"),
            new("foco", "Foco"), new("mosaico", "Mosaico")
        })
    };

    private record Visual(string Id, string Nome, string Grupo);

    private static readonly Visual[] Temas =
    {
        new("noturno", "Noturno", "Escuras"), new("oceano", "Oceano", "Escuras"), new("esmeralda", "Esmeralda", "Escuras"),
        new("aurora", "Aurora", "Escuras"), new("rubi", "Rubi", "Escuras"), new("solar", "Solar", "Escuras"),
        new("lavanda", "Lavanda", "Escuras"), new("coral", "Coral", "Escuras"), new("meia-noite", "Meia-noite", "Escuras"),
        new("grafite", "Grafite", "Escuras"),
        new("safira", "Safira", "Escuras"),
        new("ametista", "Ametista", "Escuras"),
        new("petroleo", "Petróleo", "Escuras"),
        new("floresta", "Floresta", "Escuras"),
        new("oliva", "Oliva", "Escuras"),
        new("cobre", "Cobre", "Escuras"),
        new("vinho", "Vinho", "Escuras"),
        new("neon", "Neon", "Escuras"),
        new("chocolate", "Chocolate", "Escuras"),
        new("claro", "Claro", "Claras"), new("areia", "Areia", "Claras"), new("artico", "Ártico", "Claras"),
        new("ceu", "Céu", "Claras"),
        new("menta", "Menta", "Claras"),
        new("lilas", "Lilás", "Claras"),
        new("rosa", "Rosa", "Claras"),
        new("pessego", "Pêssego", "Claras"),
        new("nevoa", "Névoa", "Claras")
    };

    private static readonly Visual[] Fundos =
    {
        new("brilho", "Brilho", "Clássicos"), new("grade", "Grade", "Clássicos"), new("pontos", "Pontos", "Clássicos"),
        new("geometrico", "Geométrico", "Clássicos"), new("listras", "Listras", "Clássicos"), new("liso", "Liso", "Clássicos"),
        new("ondas", "Ondas", "Formas"), new("topografia", "Topografia", "Formas"), new("hexagonos", "Hexágonos", "Formas"),
        new("malha", "Malha", "Formas"),
        new("aurora", "Aurora", "Feitos para movimento"), new("fluido", "Fluido", "Feitos para movimento"),
        new("bokeh", "Bokeh", "Feitos para movimento"), new("particulas", "Partículas", "Feitos para movimento"),
        new("estrelas", "Estrelas", "Feitos para movimento")
    };

    private const string ChaveAbas = "insitalent.abas";

    private bool Pronto;
    private bool Movimento;
    private string? Popover;
    private bool Apresentacao;
    private string AbaId = "individual";
    private int TemaIdx;
    private int FundoIdx;
    private readonly Dictionary<string, int> ModeloIdx = new();
    private List<AbaPersonalizada> Personalizadas = new();

    private bool DialogoAberto;
    private bool ConfigAberta;
    private bool IAAberta;
    private Configuracoes Config = new();
    private readonly RelatorioHost RelHost = new();
    private RelatorioDados? RelatorioAberto;
    private const string ChaveConfig = "insitalent.config";
    private AbaPersonalizada? Editando;

    private List<Aba> Abas
    {
        get
        {
            var l = Fixas.Where(a => !Config.AbasOcultas.Contains(a.Id))
                .Concat(Personalizadas.Select(p => new Aba(p.Id, p.Nome, p.Nome, p.Icone, ModelosDe(p), p)))
                .ToList();
            // nunca deixa o menu vazio
            return l.Count > 0 ? l : new List<Aba> { Fixas[0] };
        }
    }

    private int AbaIdx => Math.Max(0, Abas.FindIndex(a => a.Id == AbaId));
    private Aba AbaAtual => Abas[AbaIdx];

    private Opcao ModeloAtual
    {
        get
        {
            var modelos = AbaAtual.Modelos;
            return modelos[Math.Clamp(ModeloIdx.GetValueOrDefault(AbaAtual.Id), 0, modelos.Length - 1)];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        TemaIdx = IndiceVisual(Temas, await Armazenamento.LerTextoAsync("insimatch.tema"));
        FundoIdx = IndiceVisual(Fundos, await Armazenamento.LerTextoAsync("insitalent.fundo"));
        Movimento = await Armazenamento.LerTextoAsync("insitalent.movimento") == "on";
        Personalizadas = await Armazenamento.CarregarAsync<List<AbaPersonalizada>>(ChaveAbas) ?? new();
        Config = await Armazenamento.CarregarAsync<Configuracoes>(ChaveConfig) ?? new();
        AbaId = Abas[0].Id;

        var abaSalva = await Armazenamento.LerTextoAsync("insitalent.aba");
        if (Abas.Any(a => a.Id == abaSalva)) AbaId = abaSalva!;

        foreach (var aba in Abas)
        {
            var salvo = await Armazenamento.LerTextoAsync($"insitalent.modelo.{aba.Id}");
            // compatibilidade com a primeira versão (só havia o individual)
            if (salvo is null && aba.Id == "individual") salvo = await Armazenamento.LerTextoAsync("insimatch.visual");
            ModeloIdx[aba.Id] = Indice(aba.Modelos, salvo);
        }

        Pronto = true;
        StateHasChanged();
    }

    protected override void OnInitialized() => Cofre.Mudou += CofreMudou;
    private void CofreMudou() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Cofre.Mudou -= CofreMudou;

    private Task CofreCliqueAsync()
    {
        if (Cofre.Protegido) return Cofre.BloquearAsync();
        Cofre.AbrirPrivacidade();
        return Task.CompletedTask;
    }

    private static int Indice(Opcao[] opcoes, string? id) => Math.Max(0, Array.FindIndex(opcoes, o => o.Id == id));
    private static int IndiceVisual(Visual[] opcoes, string? id) => Math.Max(0, Array.FindIndex(opcoes, o => o.Id == id));

    private async Task MudarAbaAsync(string id)
    {
        AbaId = id;
        await Armazenamento.GravarTextoAsync("insitalent.aba", id);
    }

    private void AlternarPopover(string qual) => Popover = Popover == qual ? null : qual;
    private void FecharPopover() => Popover = null;

    private async Task EscolherTemaAsync(int idx)
    {
        TemaIdx = idx;
        await Armazenamento.GravarTextoAsync("insimatch.tema", Temas[idx].Id);
    }

    private async Task EscolherFundoAsync(int idx)
    {
        FundoIdx = idx;
        await Armazenamento.GravarTextoAsync("insitalent.fundo", Fundos[idx].Id);
    }

    private async Task AlternarMovimentoAsync()
    {
        Movimento = !Movimento;
        await Armazenamento.GravarTextoAsync("insitalent.movimento", Movimento ? "on" : "off");
    }

    private async Task MudarModeloAsync()
    {
        var aba = AbaAtual;
        ModeloIdx[aba.Id] = (ModeloIdx.GetValueOrDefault(aba.Id) + 1) % aba.Modelos.Length;
        await Armazenamento.GravarTextoAsync($"insitalent.modelo.{aba.Id}", ModeloAtual.Id);
    }

    private void AlternarApresentacao() => Apresentacao = !Apresentacao;

    private void GerarRelatorio()
    {
        Popover = null;
        RelatorioAberto = RelHost.Gerar?.Invoke();
    }

    /// <summary>Cria uma aba nova com o que a IA gerou (nada existente é alterado).</summary>
    private async Task CriarAbaIAAsync(ResultadoIA r)
    {
        var nova = new AbaPersonalizada
        {
            Nome = r.NomeAba,
            Icone = r.Slides ? "slides" : "raio",
            Singular = r.Slides ? "slide" : "registro",
            Tipo = r.Slides ? "slides" : "painel"
        };
        if (r.Slides && r.Deck is not null)
            await Armazenamento.SalvarAsync(nova.ChaveDados, r.Deck);
        else if (r.Painel is not null)
            await Armazenamento.SalvarAsync(nova.ChaveDados, new List<Cliente> { r.Painel });
        Personalizadas.Add(nova);
        await Armazenamento.SalvarAsync(ChaveAbas, Personalizadas);
        IAAberta = false;
        await MudarAbaAsync(nova.Id);
    }

    private async Task SalvarConfigAsync(Configuracoes c)
    {
        Config = c;
        ConfigAberta = false;
        if (!Abas.Any(a => a.Id == AbaId)) AbaId = Abas[0].Id;
        await Armazenamento.SalvarAsync(ChaveConfig, Config);
    }

    private async Task TelaCheiaAsync()
    {
        Apresentacao = true;
        await JS.InvokeVoidAsync("insimatch.telaCheia");
    }

    // ---------- Abas personalizadas ----------

    private void AbrirCriacao()
    {
        Editando = null;
        DialogoAberto = true;
    }

    private void AbrirEdicao(AbaPersonalizada p)
    {
        Editando = p;
        DialogoAberto = true;
    }

    private void FecharDialogo() => DialogoAberto = false;

    private async Task SalvarAbaAsync(FormAba f)
    {
        if (Editando is { } e)
        {
            e.Nome = f.Nome;
            e.Icone = f.Icone;
            e.Singular = f.Singular;
        }
        else
        {
            var nova = new AbaPersonalizada
            {
                Nome = f.Nome, Icone = f.Icone, Singular = f.Singular,
                Tipo = f.Inicio switch { "slides" => "slides", "fluxo" => "fluxo", _ => "painel" }
            };
            switch (f.Inicio)
            {
                case "exemplo":
                    var exemplo = AvaliacaoCliente.Exemplo();
                    exemplo.Nome = "Exemplo";
                    await Armazenamento.SalvarAsync(nova.ChaveDados, new List<Cliente> { exemplo });
                    break;
                case "slides":
                    var deck = SlidesRegras.Exemplo();
                    deck.Nome = f.Nome;
                    await Armazenamento.SalvarAsync(nova.ChaveDados, deck);
                    break;
                case "fluxo":
                    await Armazenamento.SalvarAsync(nova.ChaveDados, FluxoRegras.Exemplo());
                    break;
            }
            Personalizadas.Add(nova);
            AbaId = nova.Id;
            await Armazenamento.GravarTextoAsync("insitalent.aba", nova.Id);
        }
        await Armazenamento.SalvarAsync(ChaveAbas, Personalizadas);
        DialogoAberto = false;
    }

    private async Task ExcluirAbaAsync()
    {
        if (Editando is not { } e) return;
        Personalizadas.Remove(e);
        await Armazenamento.SalvarAsync(ChaveAbas, Personalizadas);
        await JS.InvokeVoidAsync("insimatch.remover", e.ChaveDados);
        await JS.InvokeVoidAsync("insimatch.remover", $"insitalent.modelo.{e.Id}");
        if (AbaId == e.Id || !Abas.Any(a => a.Id == AbaId)) await MudarAbaAsync(Abas[0].Id);
        DialogoAberto = false;
    }

    /// <summary>Barra de ferramentas compartilhada por todas as abas.</summary>
    private RenderFragment Ferramentas => @<div class="ferramentas">
        @if (Apresentacao && Config.MostrarTrocaAbasApresentacao && Abas.Count > 1)
        {
            <div class="seg-abas" style="--ativo:@AbaIdx; --n:@Abas.Count">
                <span class="seg-indicador"></span>
                @foreach (var aba in Abas)
                {
                    var id = aba.Id;
                    <button class="@(id == AbaAtual.Id ? "ativo" : "")" title="@aba.Nome" @onclick="() => MudarAbaAsync(id)">@aba.Curto</button>
                }
            </div>
        }
        @if (Config.MostrarCor || Config.MostrarFundo || Config.MostrarMovimento || Config.MostrarModelo)
        {
        <div class="grupo-ferr">
            @if (Config.MostrarCor)
            {
            <button class="ferr @(Popover == "cor" ? "ativo" : "")" title="Escolher a cor da página" @onclick='() => AlternarPopover("cor")'>
                <span class="bolinha"></span>
                <span class="ferr-txt"><small>Cor</small>@Temas[TemaIdx].Nome</span>
            </button>
            }
            @if (Config.MostrarFundo)
            {
            <button class="ferr @(Popover == "fundo" ? "ativo" : "")" title="Escolher o papel de parede" @onclick='() => AlternarPopover("fundo")'>
                <svg class="ferr-ico" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M3 16l5-5 4 4 3-3 6 6" /><circle cx="16" cy="9" r="1.6" /></svg>
                <span class="ferr-txt"><small>Fundo</small>@Fundos[FundoIdx].Nome</span>
            </button>
            }
            @if (Config.MostrarMovimento)
            {
            <button class="ferr @(Movimento ? "" : "desligado")" title="Ligar ou desligar o movimento do fundo" @onclick="AlternarMovimentoAsync">
                <svg class="mov-ico" viewBox="0 0 24 24"><path d="M3 12c2.5-4 5-4 7.5 0s5 4 7.5 0 2.5-2 3-2" /><path d="M3 17c2.5-4 5-4 7.5 0s5 4 7.5 0" opacity=".5" /></svg>
                <span class="ferr-txt"><small>Movimento</small>@(Movimento ? "Ligado" : "Desligado")</span>
            </button>
            }
            @if (Config.MostrarModelo)
            {
            <button class="ferr" title="Alternar o modelo de apresentação" @onclick="MudarModeloAsync">
                <svg class="ferr-ico" viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="10" rx="2" /><rect x="13" y="3" width="8" height="6" rx="2" /><rect x="13" y="11" width="8" height="10" rx="2" /><rect x="3" y="15" width="8" height="6" rx="2" /></svg>
                <span class="ferr-txt"><small>Modelo</small>@ModeloAtual.Nome</span>
            </button>
            }
        </div>
        }
        @if (Config.MostrarIA)
        {
            <button class="btn btn-ia" title="Gerar painel ou slides com IA a partir de uma planilha" @onclick="() => { Popover = null; IAAberta = true; }">
                ✨ Gerar com IA
            </button>
        }
        @if (Config.MostrarRelatorio)
        {
            <button class="btn" title="Gerar relatório da apresentação aberta" @onclick="GerarRelatorio">
                <IconeSvg Id="documento" Classe="btn-ico" /> Relatório
            </button>
        }
        <button class="btn primario" @onclick="AlternarApresentacao">
            @(Apresentacao ? "✎ Editar" : "▶ Apresentar")
        </button>
        @if (Config.MostrarTelaCheia)
        {
            <button class="btn icone-btn" title="Tela cheia" @onclick="TelaCheiaAsync">⛶</button>
        }

        @if (Popover is not null)
        {
            <div class="pop-fundo" @onclick="FecharPopover"></div>
            <div class="popover" role="dialog" aria-label="@(Popover == "cor" ? "Cor da página" : "Papel de parede")">
                @if (Popover == "cor")
                {
                    <div class="pop-titulo">Cor da página <small>@Temas.Length opções</small></div>
                    @foreach (var grupo in Temas.Select(t => t.Grupo).Distinct())
                    {
                        <div class="pop-secao">@grupo</div>
                        <div class="pop-grade">
                            @for (var i = 0; i < Temas.Length; i++)
                            {
                                if (Temas[i].Grupo != grupo) continue;
                                var idx = i;
                                <button class="pop-item @(idx == TemaIdx ? "sel" : "")" @onclick="() => EscolherTemaAsync(idx)">
                                    <span class="pc-amostra" data-tema="@Temas[idx].Id"><i></i><b></b><em></em><u></u></span>
                                    <span>@Temas[idx].Nome</span>
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="pop-titulo">Papel de parede <small>@Fundos.Length opções</small></div>
                    @foreach (var grupo in Fundos.Select(f => f.Grupo).Distinct())
                    {
                        <div class="pop-secao">@grupo</div>
                        <div class="pop-grade">
                            @for (var i = 0; i < Fundos.Length; i++)
                            {
                                if (Fundos[i].Grupo != grupo) continue;
                                var idx = i;
                                <button class="pop-item @(idx == FundoIdx ? "sel" : "")" @onclick="() => EscolherFundoAsync(idx)">
                                    <span class="mini-papel"><PapelDeParede Fundo="@Fundos[idx].Id" /></span>
                                    <span>@Fundos[idx].Nome</span>
                                </button>
                            }
                        </div>
                    }
                    <p class="pop-dica">Ligue <strong>Movimento</strong> na barra para animar o fundo. Desligado, ele fica parado.</p>
                }
            </div>
        }
    </div>;
}
