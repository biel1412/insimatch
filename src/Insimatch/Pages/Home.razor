@page "/"
@inject ArmazenamentoService Armazenamento
@inject IJSRuntime JS

<div class="app @(Apresentacao ? "modo-apresentacao" : "")" data-tema="@Temas[TemaIdx].Id" data-fundo="@Fundos[FundoIdx].Id">
    <PapelDeParede Fundo="@Fundos[FundoIdx].Id" />

    @* Menu principal: dock vertical com indicador deslizante *@
    <nav class="dock" style="--ativo:@AbaIdx" aria-label="Funções">
        <div class="dock-logo" title="insiTalent">i<span>T</span></div>
        <div class="dock-itens">
            <span class="dock-indicador"></span>
            @for (var i = 0; i < Abas.Length; i++)
            {
                var idx = i;
                var aba = Abas[i];
                <button class="dock-item @(idx == AbaIdx ? "ativo" : "")" data-tip="@aba.Nome"
                        aria-current="@(idx == AbaIdx ? "page" : null)" @onclick="() => MudarAbaAsync(idx)">
                    <span class="dock-ico">
                        @if (aba.Id == "individual")
                        {
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6" /><path d="M4.8 20c.8-4 3.7-6.2 7.2-6.2s6.4 2.2 7.2 6.2" /></svg>
                        }
                        else if (aba.Id == "time")
                        {
                            <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2" /><circle cx="17" cy="9.5" r="2.4" /><path d="M2.8 19c.6-3.3 3.2-5.2 6.2-5.2s5.6 1.9 6.2 5.2" /><path d="M15.2 14.3c2.6-.3 5 1.2 5.8 4.7" /></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="4" rx="1.5" /><rect x="4" y="10" width="16" height="4" rx="1.5" /><rect x="4" y="16" width="10" height="4" rx="1.5" /></svg>
                        }
                    </span>
                    <span class="dock-txt">@aba.Curto</span>
                </button>
            }
        </div>
        <div class="dock-rodape">@(AbaIdx + 1)/@Abas.Length</div>
    </nav>

    @if (!Pronto)
    {
        <div class="vazio">Carregando…</div>
    }
    else
    {
        @switch (Abas[AbaIdx].Id)
        {
            case "time":
                <TimeAba @key="@("time")" Apresentacao="Apresentacao" Modelo="@ModeloAtual.Id" Ferramentas="Ferramentas" />
                break;
            case "fila":
                <FilaAba @key="@("fila")" Apresentacao="Apresentacao" Modelo="@ModeloAtual.Id" Ferramentas="Ferramentas" />
                break;
            default:
                <IndividualAba @key="@("individual")" Apresentacao="Apresentacao" Modelo="@ModeloAtual.Id" Ferramentas="Ferramentas" />
                break;
        }
    }
</div>

@code {
    private record Aba(string Id, string Nome, string Curto, Opcao[] Modelos);

    private static readonly Aba[] Abas =
    {
        new("individual", "Resultado individual", "Individual", new Opcao[]
        {
            new("cartoes", "Cartões"), new("graficos", "Gráficos"), new("placar", "Placar"),
            new("foco", "Foco"), new("mosaico", "Mosaico")
        }),
        new("time", "Resultado do time", "Time", new Opcao[]
        {
            new("cartoes", "Cartões"), new("placar", "Placar"), new("foco", "Foco")
        }),
        new("fila", "Atualização de fila", "Fila", new Opcao[]
        {
            new("cartoes", "Cartões"), new("placar", "Placar"), new("foco", "Foco")
        })
    };

    private static readonly Opcao[] Temas =
    {
        new("noturno", "Noturno"), new("oceano", "Oceano"), new("esmeralda", "Esmeralda"),
        new("aurora", "Aurora"), new("claro", "Claro")
    };

    private static readonly Opcao[] Fundos =
    {
        new("brilho", "Brilho"), new("aurora", "Aurora"), new("ondas", "Ondas"), new("grade", "Grade"),
        new("pontos", "Pontos"), new("geometrico", "Geométrico"), new("liso", "Liso")
    };

    private bool Pronto;
    private bool Apresentacao;
    private int AbaIdx;
    private int TemaIdx;
    private int FundoIdx;
    private readonly int[] ModeloIdx = new int[Abas.Length];

    private Opcao ModeloAtual => Abas[AbaIdx].Modelos[ModeloIdx[AbaIdx]];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        TemaIdx = Indice(Temas, await Armazenamento.LerTextoAsync("insimatch.tema"));
        FundoIdx = Indice(Fundos, await Armazenamento.LerTextoAsync("insitalent.fundo"));
        AbaIdx = Math.Max(0, Array.FindIndex(Abas, a => a.Id == "individual"));
        var abaSalva = await Armazenamento.LerTextoAsync("insitalent.aba");
        var achou = Array.FindIndex(Abas, a => a.Id == abaSalva);
        if (achou >= 0) AbaIdx = achou;

        for (var i = 0; i < Abas.Length; i++)
        {
            var salvo = await Armazenamento.LerTextoAsync($"insitalent.modelo.{Abas[i].Id}");
            // compatibilidade com a versão anterior (só havia o individual)
            if (salvo is null && Abas[i].Id == "individual") salvo = await Armazenamento.LerTextoAsync("insimatch.visual");
            ModeloIdx[i] = Indice(Abas[i].Modelos, salvo);
        }

        Pronto = true;
        StateHasChanged();
    }

    private static int Indice(Opcao[] opcoes, string? id) => Math.Max(0, Array.FindIndex(opcoes, o => o.Id == id));

    private async Task MudarAbaAsync(int idx)
    {
        AbaIdx = idx;
        await Armazenamento.GravarTextoAsync("insitalent.aba", Abas[idx].Id);
    }

    private async Task MudarTemaAsync()
    {
        TemaIdx = (TemaIdx + 1) % Temas.Length;
        await Armazenamento.GravarTextoAsync("insimatch.tema", Temas[TemaIdx].Id);
    }

    private async Task MudarFundoAsync()
    {
        FundoIdx = (FundoIdx + 1) % Fundos.Length;
        await Armazenamento.GravarTextoAsync("insitalent.fundo", Fundos[FundoIdx].Id);
    }

    private async Task MudarModeloAsync()
    {
        var modelos = Abas[AbaIdx].Modelos;
        ModeloIdx[AbaIdx] = (ModeloIdx[AbaIdx] + 1) % modelos.Length;
        await Armazenamento.GravarTextoAsync($"insitalent.modelo.{Abas[AbaIdx].Id}", ModeloAtual.Id);
    }

    private void AlternarApresentacao() => Apresentacao = !Apresentacao;

    private async Task TelaCheiaAsync()
    {
        Apresentacao = true;
        await JS.InvokeVoidAsync("insimatch.telaCheia");
    }

    /// <summary>Barra de ferramentas compartilhada pelas três abas.</summary>
    private RenderFragment Ferramentas => @<div class="ferramentas">
        @if (Apresentacao)
        {
            <div class="seg-abas" style="--ativo:@AbaIdx; --n:@Abas.Length">
                <span class="seg-indicador"></span>
                @for (var i = 0; i < Abas.Length; i++)
                {
                    var idx = i;
                    <button class="@(idx == AbaIdx ? "ativo" : "")" @onclick="() => MudarAbaAsync(idx)">@Abas[idx].Curto</button>
                }
            </div>
        }
        <div class="grupo-ferr">
            <button class="ferr" title="Mudar a cor da página" @onclick="MudarTemaAsync">
                <span class="bolinha"></span>
                <span class="ferr-txt"><small>Cor</small>@Temas[TemaIdx].Nome</span>
            </button>
            <button class="ferr" title="Mudar o papel de parede" @onclick="MudarFundoAsync">
                <svg class="ferr-ico" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M3 16l5-5 4 4 3-3 6 6" /><circle cx="16" cy="9" r="1.6" /></svg>
                <span class="ferr-txt"><small>Fundo</small>@Fundos[FundoIdx].Nome</span>
            </button>
            <button class="ferr" title="Alternar o modelo de apresentação" @onclick="MudarModeloAsync">
                <svg class="ferr-ico" viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="10" rx="2" /><rect x="13" y="3" width="8" height="6" rx="2" /><rect x="13" y="11" width="8" height="10" rx="2" /><rect x="3" y="15" width="8" height="6" rx="2" /></svg>
                <span class="ferr-txt"><small>Modelo</small>@ModeloAtual.Nome</span>
            </button>
        </div>
        <button class="btn primario" @onclick="AlternarApresentacao">
            @(Apresentacao ? "✎ Editar" : "▶ Apresentar")
        </button>
        <button class="btn icone-btn" title="Tela cheia" @onclick="TelaCheiaAsync">⛶</button>
    </div>;
}
