@* Aba personalizada no formato de slides *@
@implements IDisposable
@inject ArmazenamentoService Armazenamento
@inject IJSRuntime JS

<PageTitle>insiTalent · @Contexto.RotuloSup</PageTitle>

<aside class="lateral lateral-cliente">
    <div class="marca marca-com-acao">
        <div>
            <div class="marca-logo">insi<span>Talent</span></div>
            <div class="marca-sub">@Contexto.RotuloSup · slides</div>
        </div>
        @if (OnConfigurar.HasDelegate)
        {
            <button class="btn icone-btn" title="Configurar esta aba (nome, ícone, excluir)" @onclick="() => OnConfigurar.InvokeAsync()">⚙</button>
        }
    </div>

    <div class="abas">
        <button class="@(Aba == "slide" ? "ativa" : "")" @onclick='() => { Aba = "slide"; }'>Slide</button>
        <button class="@(Aba == "todos" ? "ativa" : "")" @onclick='() => { Aba = "todos"; }'>Todos (@(Deck?.Slides.Count ?? 0))</button>
    </div>

    @if (Deck is null || Atual is null)
    {
        <div class="vazio">Carregando…</div>
    }
    else if (Aba == "slide")
    {
        <div class="form">
            <div class="slide-nav-editor">
                <button class="icone" title="Slide anterior" disabled="@(Indice == 0)" @onclick="() => Mover(-1)">‹</button>
                <strong>Slide @(Indice + 1) de @Deck.Slides.Count</strong>
                <button class="icone" title="Próximo slide" disabled="@(Indice == Deck.Slides.Count - 1)" @onclick="() => Mover(1)">›</button>
            </div>

            <label>Título
                <input @bind="Atual.Titulo" @bind:event="oninput" @bind:after="SalvarAsync" placeholder="Título do slide" />
            </label>
            <label>Subtítulo (opcional)
                <input @bind="Atual.Subtitulo" @bind:event="oninput" @bind:after="SalvarAsync" placeholder="Uma linha de apoio" />
            </label>
            <label>Texto (opcional)
                <textarea rows="5" @bind="Atual.Texto" @bind:event="oninput" @bind:after="SalvarAsync"
                          placeholder="Escreva livremente. Comece a linha com “-” para virar tópico."></textarea>
            </label>

            <div class="form-grupo">Imagens (@Atual.Imagens.Count/@SlidesRegras.MaxImagens)</div>
            @foreach (var img in Atual.Imagens)
            {
                var id = img.Id;
                <div class="img-card">
                    <div class="img-previa">
                        @if (Imagens.TryGetValue(id, out var src))
                        {
                            <img src="@src" alt="" />
                        }
                    </div>
                    <div class="img-dados">
                        <input @bind="img.Legenda" @bind:event="oninput" @bind:after="SalvarAsync" placeholder="Legenda (opcional)" />
                        <div class="img-opcoes">
                            <label class="check"><input type="checkbox" @bind="img.Inteira" @bind:after="SalvarAsync" /><span>Mostrar inteira</span></label>
                            <span class="mudo">@img.Largura×@img.Altura</span>
                            <button class="link perigo-txt" @onclick="() => RemoverImagemAsync(id)">Remover</button>
                        </div>
                    </div>
                </div>
            }
            @if (Atual.Imagens.Count < SlidesRegras.MaxImagens)
            {
                <label class="btn arquivo @(Carregando ? "carregando" : "")">
                    @(Carregando ? "Carregando…" : "+ Carregar imagem")
                    <InputFile OnChange="CarregarImagemAsync" accept="image/png,image/jpeg,image/webp,image/gif" multiple />
                </label>
            }
            <div class="calculado">Posição automática: <strong>@NomeLayout(SlidesRegras.Layout(Atual))</strong></div>
            @if (!string.IsNullOrEmpty(Mensagem))
            {
                <div class="aviso">@Mensagem</div>
            }

            <div class="form-grupo">
                Campos (@Atual.Campos.Count)
            </div>
            <datalist id="grupos-slide"></datalist>
            <div class="campos-lista">
                @for (var i = 0; i < Atual.Campos.Count; i++)
                {
                    var idx = i;
                    var c = Atual.Campos[i];
                    <CampoEditor @key="c.Id" C="c" Aberto="Abertos.Contains(c.Id)" ListaGrupos="grupos-slide"
                                 Primeiro="idx == 0" Ultimo="idx == Atual.Campos.Count - 1"
                                 OnAlternar="() => Alternar(c.Id)" OnMudou="SalvarAsync"
                                 OnMover="d => MoverCampoAsync(idx, d)" OnDuplicar="() => DuplicarCampoAsync(idx)"
                                 OnExcluir="() => ExcluirCampoAsync(idx)" />
                }
            </div>
            <div class="tipos-grade">
                @foreach (var t in Enum.GetValues<TipoCampo>())
                {
                    <button class="tipo-btn" @onclick="() => AdicionarCampoAsync(t)">
                        <span>@AvaliacaoCliente.IconeTipo(t)</span>@AvaliacaoCliente.NomeTipo(t)
                    </button>
                }
            </div>

            @* ---------- Aparência deste slide ---------- *@
            <div class="ap-bloco @(AparenciaAberta ? "aberta" : "")">
                <button type="button" class="ap-cab" @onclick="() => { AparenciaAberta = !AparenciaAberta; }">
                    <span class="ap-amostra" style="@AmostraSlide(Atual)">Aa</span>
                    <span>Aparência deste slide <em>@(Atual.AparenciaPersonalizada ? "personalizada" : "segue o tema")</em></span>
                    <span class="campo-chev">▾</span>
                </button>
                @if (AparenciaAberta)
                {
                    <div class="ap-corpo">
                        <div class="ap-rotulo">Estrutura</div>
                        <div class="ap-formatos est">
                            @foreach (var (id, nome) in Estruturas)
                            {
                                var e = id;
                                <button type="button" class="ap-formato @(Atual.Estrutura == e ? "sel" : "")" title="@DicaEstrutura(e)" @onclick="() => DefinirAsync(() => Atual.Estrutura = e)">
                                    <span class="ap-est est-ico-@(e == "" ? "auto" : e)"><i></i><i></i><i></i></span>
                                    <small>@nome</small>
                                </button>
                            }
                        </div>
                        <p class="dica ap-dica">@DicaEstrutura(Atual.Estrutura)</p>

                        <div class="ap-rotulo">Fundo da página</div>
                        <div class="ap-cores">
                            <button type="button" class="ap-cor auto @(Atual.Fundo == "" ? "sel" : "")" title="Do tema" @onclick="() => DefinirAsync(() => Atual.Fundo = string.Empty)">A</button>
                            @foreach (var (cor, nome) in FundosSlide)
                            {
                                var c = cor;
                                <button type="button" class="ap-cor @(Atual.Fundo == c ? "sel" : "")" title="@nome" style="background:@c" @onclick="() => DefinirAsync(() => Atual.Fundo = c)"></button>
                            }
                            <label class="ap-cor ap-livre" title="Outra cor">
                                <input type="color" value="@(Atual.Fundo.StartsWith("#") ? Atual.Fundo : "#1e293b")" @onchange="FundoLivreAsync" />
                                <span>+</span>
                            </label>
                        </div>

                        <div class="ap-rotulo">Cor do texto</div>
                        <div class="ap-cores">
                            <button type="button" class="ap-cor auto @(Atual.CorTexto == "" ? "sel" : "")" title="Automática (contraste com o fundo)" @onclick="() => DefinirAsync(() => Atual.CorTexto = string.Empty)">A</button>
                            @foreach (var (cor, nome) in CoresTexto)
                            {
                                var c = cor;
                                <button type="button" class="ap-cor @(Atual.CorTexto == c ? "sel" : "")" title="@nome" style="background:@c" @onclick="() => DefinirAsync(() => Atual.CorTexto = c)"></button>
                            }
                            <label class="ap-cor ap-livre" title="Outra cor">
                                <input type="color" value="@(Atual.CorTexto == "" ? "#ffffff" : Atual.CorTexto)" @onchange="TextoLivreAsync" />
                                <span>+</span>
                            </label>
                        </div>

                        <div class="ap-rotulo">Cor de destaque <small>(marcadores, faixa do topo, gráficos)</small></div>
                        <div class="ap-cores">
                            <button type="button" class="ap-cor auto @(Atual.CorDestaque == "" ? "sel" : "")" title="Do tema" @onclick="() => DefinirAsync(() => Atual.CorDestaque = string.Empty)">A</button>
                            @foreach (var (cor, nome) in CoresDestaque)
                            {
                                var c = cor;
                                <button type="button" class="ap-cor @(Atual.CorDestaque == c ? "sel" : "")" title="@nome" style="background:@c" @onclick="() => DefinirAsync(() => Atual.CorDestaque = c)"></button>
                            }
                        </div>

                        <div class="ap-linha">
                            <div>
                                <div class="ap-rotulo">Tamanho do texto</div>
                                <div class="segmentado">
                                    <button class="@(Atual.TamanhoTexto == "p" ? "sel" : "")" @onclick='() => DefinirAsync(() => Atual.TamanhoTexto = "p")'>P</button>
                                    <button class="@(Atual.TamanhoTexto == "" ? "sel" : "")" @onclick="() => DefinirAsync(() => Atual.TamanhoTexto = string.Empty)">M</button>
                                    <button class="@(Atual.TamanhoTexto == "g" ? "sel" : "")" @onclick='() => DefinirAsync(() => Atual.TamanhoTexto = "g")'>G</button>
                                </div>
                            </div>
                            <div>
                                <div class="ap-rotulo">Alinhamento</div>
                                <div class="segmentado">
                                    <button class="@(Atual.Alinhamento == "" ? "sel" : "")" @onclick="() => DefinirAsync(() => Atual.Alinhamento = string.Empty)">Esquerda</button>
                                    <button class="@(Atual.Alinhamento == "centro" ? "sel" : "")" @onclick='() => DefinirAsync(() => Atual.Alinhamento = "centro")'>Centro</button>
                                </div>
                            </div>
                        </div>
                        @if (Atual.Imagens.Count > 0 && Atual.Estrutura != "capa")
                        {
                            <label class="check"><input type="checkbox" checked="@Atual.InverterImagem" @onchange="InverterAsync" /><span>Imagens do outro lado (esquerda / acima)</span></label>
                        }

                        <div class="acoes">
                            <button class="btn btn-pequeno" @onclick="AplicarCoresTodosAsync" title="Usa o fundo, o texto e o destaque deste slide em todos">Usar estas cores em todos os slides</button>
                            @if (Atual.AparenciaPersonalizada)
                            {
                                <button class="btn btn-pequeno" @onclick="RestaurarAparenciaAsync">Restaurar</button>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(MsgAparencia))
                        {
                            <div class="calculado">@MsgAparencia</div>
                        }
                    </div>
                }
            </div>

            <div class="form-grupo">Slide</div>
            <div class="acoes">
                <button class="btn" @onclick="NovoSlideAsync">+ Novo slide</button>
                <button class="btn" @onclick="DuplicarSlideAsync">Duplicar</button>
                <button class="btn" disabled="@(Indice == 0)" @onclick="() => MoverSlideAsync(-1)">↑</button>
                <button class="btn" disabled="@(Indice == Deck.Slides.Count - 1)" @onclick="() => MoverSlideAsync(1)">↓</button>
                <button class="btn perigo" @onclick="ExcluirSlideAsync">@(ConfirmarExclusao ? "Confirmar exclusão" : "Excluir")</button>
            </div>
        </div>
    }
    else
    {
        <div class="form">
            <label>Nome da apresentação
                <input @bind="Deck.Nome" @bind:event="oninput" @bind:after="SalvarAsync" placeholder="Ex.: Resultados do trimestre" />
            </label>

            <div class="form-grupo">Tema da apresentação</div>
            <div class="temas-slide">
                @foreach (var t in TemasSlides.Lista)
                {
                    var tema = t;
                    <button class="tema-slide @(Deck.Tema == tema.Id ? "sel" : "")" @onclick="() => DefinirAsync(() => Deck.Tema = tema.Id)">
                        <span class="tema-amostra" style="@AmostraTema(tema)">
                            <b>Aa</b><i></i>
                        </span>
                        <small>@tema.Nome</small>
                    </button>
                }
            </div>
            <p class="dica">O tema vale para todos os slides. Cores escolhidas em um slide (na aba Slide → Aparência) têm prioridade.</p>

            <label>Estilo dos títulos
                <select value="@Deck.Fonte" @onchange="FonteAsync">
                    <option value="">Padrão</option>
                    <option value="elegante">Elegante (serifada)</option>
                    <option value="impacto">Impacto (caixa alta)</option>
                    <option value="suave">Suave (leve e arejada)</option>
                </select>
            </label>
            <label class="check"><input type="checkbox" checked="@Deck.MostrarRodape" @onchange="RodapeAsync" /><span>Mostrar rodapé (nome e número do slide)</span></label>
            <ul class="lista">
                @for (var i = 0; i < Deck.Slides.Count; i++)
                {
                    var idx = i;
                    var s = Deck.Slides[i];
                    <li class="@(idx == Indice ? "sel" : "")" @onclick="() => Ir(idx, true)">
                        <span class="mini-avatar neutro">@(idx + 1)</span>
                        <span class="lista-txt">
                            <strong>@(string.IsNullOrWhiteSpace(s.Titulo) ? "(sem título)" : s.Titulo)</strong>
                            <small>@Resumo(s)</small>
                        </span>
                    </li>
                }
            </ul>
            <div class="acoes">
                <button class="btn" @onclick="NovoSlideAsync">+ Novo slide</button>
            </div>

            <div class="form-grupo">Importar / exportar</div>
            <div class="acoes">
                <button class="btn" @onclick="ExportarAsync">Exportar (.json)</button>
                <label class="btn arquivo">
                    Importar slides (.json)
                    <InputFile OnChange="ImportarAsync" accept=".json,application/json" />
                </label>
            </div>
            @if (!string.IsNullOrEmpty(Mensagem))
            {
                <div class="calculado">@Mensagem</div>
            }
            <p class="dica">O arquivo exportado leva os slides e as imagens. Importar adiciona os slides ao final desta apresentação. As imagens ficam guardadas neste navegador.</p>
        </div>
    }
</aside>

<main class="principal">
    <div class="barra-topo">
        @if (Deck is not null && Deck.Slides.Count > 1 && Modelo == "slide")
        {
            <div class="navegacao">
                <button class="icone" title="Anterior (←)" @onclick="() => Mover(-1)">‹</button>
                <span>@(Indice + 1) de @Deck.Slides.Count</span>
                <button class="icone" title="Próximo (→)" @onclick="() => Mover(1)">›</button>
            </div>
        }
        <div class="espaco"></div>
        @Ferramentas
    </div>

    @if (Deck is not null && Atual is not null)
    {
        var rodape = string.IsNullOrWhiteSpace(Deck.Nome) ? Contexto.RotuloSup : Deck.Nome;
        @switch (Modelo)
        {
            case "rolagem":
                <div class="slides-rolagem">
                    @for (var i = 0; i < Deck.Slides.Count; i++)
                    {
                        <SlideVisual @key="Deck.Slides[i].Id" S="Deck.Slides[i]" Imagens="Imagens" Numero="i + 1" Total="Deck.Slides.Count" Rodape="@rodape" Deck="Deck" />
                    }
                </div>
                break;
            case "grade":
                <div class="slides-grade">
                    @for (var i = 0; i < Deck.Slides.Count; i++)
                    {
                        var idx = i;
                        <button class="slide-mini @(idx == Indice ? "sel" : "")" @onclick="() => Ir(idx, false)" title="Ir para o slide @(idx + 1)">
                            <span class="slide-mini-quadro">
                                <SlideVisual @key="Deck.Slides[idx].Id" S="Deck.Slides[idx]" Imagens="Imagens" Numero="idx + 1" Total="Deck.Slides.Count" Rodape="@rodape" Deck="Deck" />
                            </span>
                            <span class="slide-mini-nome">@(idx + 1). @(string.IsNullOrWhiteSpace(Deck.Slides[idx].Titulo) ? "Sem título" : Deck.Slides[idx].Titulo)</span>
                        </button>
                    }
                </div>
                break;
            default:
                <div class="slide-palco">
                    <SlideVisual @key="Atual.Id" S="Atual" Imagens="Imagens" Numero="Indice + 1" Total="Deck.Slides.Count" Rodape="@rodape" Ativo="true" Deck="Deck" />
                </div>
                @if (Deck.Slides.Count > 1)
                {
                    <div class="slide-pontos">
                        @for (var i = 0; i < Deck.Slides.Count; i++)
                        {
                            var idx = i;
                            <button class="@(idx == Indice ? "ativo" : "")" title="Slide @(idx + 1)" @onclick="() => Ir(idx, false)"></button>
                        }
                    </div>
                }
                break;
        }
    }
</main>

@code {
    [Parameter] public bool Apresentacao { get; set; }
    [Parameter] public string Modelo { get; set; } = "slide";
    [Parameter] public RenderFragment? Ferramentas { get; set; }
    [Parameter] public string Chave { get; set; } = "";
    [Parameter] public ContextoPainel Contexto { get; set; } = new("Slides", "slide", true);
    [Parameter] public EventCallback OnConfigurar { get; set; }
    [CascadingParameter] public RelatorioHost? Relatorio { get; set; }

    private Apresentacao? Deck;
    private int Indice;
    private Slide? Atual => Deck is null || Deck.Slides.Count == 0 ? null : Deck.Slides[Math.Clamp(Indice, 0, Deck.Slides.Count - 1)];
    private readonly Dictionary<string, string> Imagens = new();
    private readonly HashSet<string> Abertos = new();
    private string Aba = "slide";
    private string Mensagem = "";
    private bool Carregando;
    private bool ConfirmarExclusao;
    private DotNetObjectReference<SlidesAba>? Ref;
    private bool AparenciaAberta;
    private string MsgAparencia = "";

    private static readonly (string Id, string Nome)[] Estruturas =
    {
        ("", "Automática"), ("capa", "Capa"), ("secao", "Seção"), ("colunas", "Duas colunas"), ("destaque", "Mensagem")
    };
    private static string DicaEstrutura(string e) => e switch
    {
        "capa" => "Capa: título grande no centro. Se houver imagem, ela vira o fundo do slide.",
        "secao" => "Seção: divisor entre partes da apresentação, com título grande e faixa de destaque.",
        "colunas" => "Duas colunas: o texto e os tópicos se dividem em duas colunas.",
        "destaque" => "Mensagem: o texto aparece grande, como uma frase de destaque ou citação.",
        _ => "Automática: a plataforma organiza texto, campos e imagens conforme o conteúdo."
    };
    private static readonly (string Cor, string Nome)[] FundosSlide =
    {
        ("#ffffff", "Branco"), ("#f1f5f9", "Cinza-claro"), ("#fef3c7", "Creme"), ("#0b1020", "Noite"), ("#1f2937", "Grafite"),
        ("#1e3a8a", "Azul-marinho"), ("#065f46", "Verde-escuro"), ("#4c1d95", "Roxo"),
        ("linear-gradient(135deg, #0f2a5c 0%, #1e3a8a 100%)", "Degradê azul"),
        ("linear-gradient(135deg, #4c1d95 0%, #be185d 100%)", "Degradê aurora"),
        ("linear-gradient(135deg, #0c4a6e 0%, #0e7490 100%)", "Degradê oceano"),
        ("linear-gradient(135deg, #052e16 0%, #166534 100%)", "Degradê floresta")
    };
    private static readonly (string Cor, string Nome)[] CoresTexto =
    {
        ("#ffffff", "Branco"), ("#0f172a", "Preto"), ("#334155", "Cinza-escuro"), ("#1e3a8a", "Azul-marinho"),
        ("#fbbf24", "Amarelo"), ("#5eead4", "Verde-água")
    };
    private static readonly (string Cor, string Nome)[] CoresDestaque =
    {
        ("#4f46e5", "Índigo"), ("#0ea5e9", "Azul"), ("#10b981", "Verde"), ("#fbbf24", "Amarelo"),
        ("#f97316", "Laranja"), ("#ef4444", "Vermelho"), ("#ec4899", "Rosa"), ("#a855f7", "Roxo")
    };

    private string AmostraSlide(Slide s)
    {
        var (_, est) = TemasSlides.Visual(Deck, s);
        return est.Replace("--slide-fundo", "--campo-fundo").Replace("--slide-texto", "--campo-texto")
                  .Replace("--campo-fundo:", "background:").Replace("--campo-texto:", "color:");
    }
    private static string AmostraTema(TemaSlide t) => t.Id == ""
        ? ""
        : $"background:{t.Fundo};color:{t.Texto};--amostra-destaque:{t.Destaque};";

    private async Task DefinirAsync(Action mudar)
    {
        mudar();
        MsgAparencia = "";
        await SalvarAsync();
    }
    private Task FundoLivreAsync(ChangeEventArgs e) => DefinirAsync(() => Atual!.Fundo = e.Value?.ToString() ?? string.Empty);
    private Task TextoLivreAsync(ChangeEventArgs e) => DefinirAsync(() => Atual!.CorTexto = e.Value?.ToString() ?? string.Empty);
    private Task InverterAsync(ChangeEventArgs e) => DefinirAsync(() => Atual!.InverterImagem = e.Value is true);
    private Task FonteAsync(ChangeEventArgs e) => DefinirAsync(() => Deck!.Fonte = e.Value?.ToString() ?? string.Empty);
    private Task RodapeAsync(ChangeEventArgs e) => DefinirAsync(() => Deck!.MostrarRodape = e.Value is true);

    private async Task RestaurarAparenciaAsync()
    {
        if (Atual is null) return;
        Atual.Estrutura = Atual.Fundo = Atual.CorTexto = Atual.CorDestaque = Atual.TamanhoTexto = Atual.Alinhamento = string.Empty;
        Atual.InverterImagem = false;
        MsgAparencia = "";
        await SalvarAsync();
    }

    private async Task AplicarCoresTodosAsync()
    {
        if (Deck is null || Atual is null) return;
        foreach (var s in Deck.Slides)
        {
            s.Fundo = Atual.Fundo;
            s.CorTexto = Atual.CorTexto;
            s.CorDestaque = Atual.CorDestaque;
        }
        MsgAparencia = $"Cores aplicadas aos {Deck.Slides.Count} slides.";
        await SalvarAsync();
    }

    protected override void OnInitialized()
    {
        if (Relatorio is not null) Relatorio.Gerar = () => Deck is null ? null : Relatorios.De(Deck, Contexto, Imagens);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Deck = await Armazenamento.CarregarAsync<Apresentacao>(Chave) ?? new Apresentacao();
        if (Deck.Slides.Count == 0) Deck.Slides.Add(new Slide { Titulo = "Novo slide" });
        await SalvarAsync();
        var ids = Deck.Slides.SelectMany(s => s.Imagens).Select(i => i.Id).ToArray();
        if (ids.Length > 0)
        {
            var lidas = await JS.InvokeAsync<Dictionary<string, string>>("insimatch.imgLer", (object)ids);
            foreach (var kv in lidas) Imagens[kv.Key] = kv.Value;
        }
        Ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("insimatch.teclasSlides", Ref);
        StateHasChanged();
    }

    /// <summary>Setas do teclado / PageUp / PageDown / espaço navegam entre os slides.</summary>
    [JSInvokable]
    public void Tecla(int passo)
    {
        if (Modelo != "slide") return;
        Mover(passo);
        StateHasChanged();
    }

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("insimatch.teclasSlides", null);
        Ref?.Dispose();
    }

    private Task SalvarAsync() => Deck is null ? Task.CompletedTask : Armazenamento.SalvarAsync(Chave, Deck);

    private static string NomeLayout(string l) => l switch
    {
        "so-conteudo" => "só conteúdo, ocupando o slide",
        "imagem-cheia" => "imagem em tela cheia",
        "galeria" => "duas imagens lado a lado",
        "imagem-baixo" => "imagem em destaque abaixo do texto",
        "imagem-lado" => "imagem ao lado do conteúdo",
        "duas-baixo" => "duas imagens abaixo do conteúdo",
        _ => "duas imagens ao lado do conteúdo"
    };

    private static string Resumo(Slide s)
    {
        var partes = new List<string>();
        if (s.Campos.Count > 0) partes.Add($"{s.Campos.Count} campo(s)");
        if (s.Imagens.Count > 0) partes.Add($"{s.Imagens.Count} imagem(ns)");
        if (!string.IsNullOrWhiteSpace(s.Texto)) partes.Add("texto");
        return partes.Count == 0 ? "vazio" : string.Join(" · ", partes);
    }

    private void Ir(int idx, bool abrirEditor)
    {
        if (Deck is null) return;
        Indice = Math.Clamp(idx, 0, Deck.Slides.Count - 1);
        Abertos.Clear();
        ConfirmarExclusao = false;
        Mensagem = "";
        if (abrirEditor) Aba = "slide";
    }

    private void Mover(int passo)
    {
        if (Deck is null) return;
        Ir(Math.Clamp(Indice + passo, 0, Deck.Slides.Count - 1), false);
    }

    // ---------- Slides ----------

    private async Task NovoSlideAsync()
    {
        if (Deck is null) return;
        Deck.Slides.Insert(Indice + 1, new Slide());
        Ir(Indice + 1, true);
        await SalvarAsync();
    }

    private async Task DuplicarSlideAsync()
    {
        if (Deck is null || Atual is null) return;
        var copia = System.Text.Json.JsonSerializer.Deserialize<Slide>(System.Text.Json.JsonSerializer.Serialize(Atual))!;
        copia.Id = Guid.NewGuid().ToString("N")[..10];
        foreach (var c in copia.Campos) c.Id = Guid.NewGuid().ToString("N")[..10];
        foreach (var img in copia.Imagens)
        {
            var antigo = img.Id;
            img.Id = "img-" + Guid.NewGuid().ToString("N")[..12];
            if (Imagens.TryGetValue(antigo, out var src))
            {
                Imagens[img.Id] = src;
                await JS.InvokeVoidAsync("insimatch.imgSalvar", img.Id, src);
            }
        }
        Deck.Slides.Insert(Indice + 1, copia);
        Ir(Indice + 1, true);
        await SalvarAsync();
    }

    private async Task MoverSlideAsync(int delta)
    {
        if (Deck is null) return;
        var novo = Indice + delta;
        if (novo < 0 || novo >= Deck.Slides.Count) return;
        (Deck.Slides[Indice], Deck.Slides[novo]) = (Deck.Slides[novo], Deck.Slides[Indice]);
        Indice = novo;
        await SalvarAsync();
    }

    private async Task ExcluirSlideAsync()
    {
        if (Deck is null || Atual is null) return;
        if (!ConfirmarExclusao) { ConfirmarExclusao = true; return; }
        foreach (var img in Atual.Imagens)
        {
            Imagens.Remove(img.Id);
            await JS.InvokeVoidAsync("insimatch.imgRemover", img.Id);
        }
        Deck.Slides.RemoveAt(Indice);
        if (Deck.Slides.Count == 0) Deck.Slides.Add(new Slide());
        Ir(Math.Min(Indice, Deck.Slides.Count - 1), true);
        await SalvarAsync();
    }

    // ---------- Imagens ----------

    private async Task CarregarImagemAsync(InputFileChangeEventArgs e)
    {
        if (Atual is null) return;
        Mensagem = "";
        Carregando = true;
        try
        {
            foreach (var arquivo in e.GetMultipleFiles(SlidesRegras.MaxImagens))
            {
                if (Atual.Imagens.Count >= SlidesRegras.MaxImagens)
                {
                    Mensagem = $"Cada slide aceita até {SlidesRegras.MaxImagens} imagens.";
                    break;
                }
                // Reduz para no máximo 1920 px: leve para guardar e nítido para apresentar
                var formato = arquivo.ContentType == "image/png" ? "image/png" : "image/jpeg";
                var reduzida = await arquivo.RequestImageFileAsync(formato, 1920, 1920);
                using var ms = new MemoryStream();
                await reduzida.OpenReadStream(25 * 1024 * 1024).CopyToAsync(ms);
                var dataUrl = $"data:{formato};base64,{Convert.ToBase64String(ms.ToArray())}";
                var dim = await JS.InvokeAsync<int[]>("insimatch.imgDimensoes", dataUrl);
                var img = new ImagemSlide { Largura = dim.Length > 0 ? dim[0] : 0, Altura = dim.Length > 1 ? dim[1] : 0 };
                await JS.InvokeVoidAsync("insimatch.imgSalvar", img.Id, dataUrl);
                Imagens[img.Id] = dataUrl;
                Atual.Imagens.Add(img);
            }
            await SalvarAsync();
        }
        catch (Exception ex)
        {
            Mensagem = "Não foi possível carregar a imagem: " + ex.Message;
        }
        finally
        {
            Carregando = false;
        }
    }

    private async Task RemoverImagemAsync(string id)
    {
        if (Atual is null) return;
        Atual.Imagens.RemoveAll(i => i.Id == id);
        Imagens.Remove(id);
        await JS.InvokeVoidAsync("insimatch.imgRemover", id);
        await SalvarAsync();
    }

    // ---------- Campos ----------

    private void Alternar(string id)
    {
        if (!Abertos.Remove(id)) Abertos.Add(id);
    }

    private async Task AdicionarCampoAsync(TipoCampo tipo)
    {
        if (Atual is null) return;
        var campo = new CampoCliente
        {
            Tipo = tipo,
            Casas = tipo switch { TipoCampo.Moeda or TipoCampo.Percentual => 2, TipoCampo.Decimal => 1, _ => 0 },
            Visual = AvaliacaoCliente.VisualPadrao(tipo)
        };
        Atual.Campos.Add(campo);
        Abertos.Clear();
        Abertos.Add(campo.Id);
        await SalvarAsync();
    }

    private async Task MoverCampoAsync(int idx, int delta)
    {
        if (Atual is null) return;
        var novo = idx + delta;
        if (novo < 0 || novo >= Atual.Campos.Count) return;
        (Atual.Campos[idx], Atual.Campos[novo]) = (Atual.Campos[novo], Atual.Campos[idx]);
        await SalvarAsync();
    }

    private async Task DuplicarCampoAsync(int idx)
    {
        if (Atual is null) return;
        var copia = System.Text.Json.JsonSerializer.Deserialize<CampoCliente>(System.Text.Json.JsonSerializer.Serialize(Atual.Campos[idx]))!;
        copia.Id = Guid.NewGuid().ToString("N")[..10];
        copia.Nome += " (cópia)";
        Atual.Campos.Insert(idx + 1, copia);
        await SalvarAsync();
    }

    private async Task ExcluirCampoAsync(int idx)
    {
        if (Atual is null) return;
        Atual.Campos.RemoveAt(idx);
        await SalvarAsync();
    }

    // ---------- Importar / exportar ----------

    private class Pacote
    {
        public Apresentacao Apresentacao { get; set; } = new();
        public Dictionary<string, string> Imagens { get; set; } = new();
    }

    private async Task ExportarAsync()
    {
        if (Deck is null) return;
        var ids = Deck.Slides.SelectMany(s => s.Imagens).Select(i => i.Id).ToHashSet();
        var pacote = new Pacote { Apresentacao = Deck, Imagens = Imagens.Where(kv => ids.Contains(kv.Key)).ToDictionary(kv => kv.Key, kv => kv.Value) };
        var json = System.Text.Json.JsonSerializer.Serialize(pacote, ArmazenamentoService.JsonExportacao);
        var nome = string.IsNullOrWhiteSpace(Deck.Nome) ? "slides" : Deck.Nome.Trim().Replace(' ', '-').ToLowerInvariant();
        await JS.InvokeVoidAsync("insimatch.baixar", $"insitalent-{nome}.json", json, "application/json;charset=utf-8");
    }

    private async Task ImportarAsync(InputFileChangeEventArgs e)
    {
        if (Deck is null) return;
        try
        {
            using var leitor = new StreamReader(e.File.OpenReadStream(60 * 1024 * 1024));
            var texto = (await leitor.ReadToEndAsync()).TrimStart('﻿');
            var pacote = System.Text.Json.JsonSerializer.Deserialize<Pacote>(texto, ArmazenamentoService.JsonExportacao);
            if (pacote?.Apresentacao is null || pacote.Apresentacao.Slides.Count == 0) { Mensagem = "Nenhum slide encontrado no arquivo."; return; }
            foreach (var s in pacote.Apresentacao.Slides)
            {
                s.Id = Guid.NewGuid().ToString("N")[..10];
                foreach (var img in s.Imagens)
                {
                    var antigo = img.Id;
                    img.Id = "img-" + Guid.NewGuid().ToString("N")[..12];
                    if (pacote.Imagens.TryGetValue(antigo, out var src))
                    {
                        Imagens[img.Id] = src;
                        await JS.InvokeVoidAsync("insimatch.imgSalvar", img.Id, src);
                    }
                }
                s.Imagens.RemoveAll(i => !Imagens.ContainsKey(i.Id));
                Deck.Slides.Add(s);
            }
            Mensagem = $"{pacote.Apresentacao.Slides.Count} slide(s) importado(s).";
            await SalvarAsync();
        }
        catch (Exception ex)
        {
            Mensagem = "Não foi possível importar: " + ex.Message;
        }
    }
}
