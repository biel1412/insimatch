@* Uma linha de comparação: meta x realizado *@
<div class="linha-meta @(Atingiu ? "ok" : "falta")">
    <span class="lm-icone">@(Atingiu ? "✓" : "•")</span>
    <span class="lm-nome">@Nome</span>
    <span class="lm-valor">@Meta.ToString("N0")</span>
    <span class="lm-dif">
        @if (Atingiu)
        {
            @($"+{Realizado - Meta:N0} · {Percentual:N0}%")
        }
        else
        {
            @($"faltam {Meta - Realizado:N0} · {Percentual:N0}%")
        }
    </span>
</div>

@code {
    [Parameter] public string Nome { get; set; } = "";
    [Parameter] public int Meta { get; set; }
    [Parameter] public int Realizado { get; set; }

    private bool Atingiu => Realizado >= Meta;
    private double Percentual => Meta > 0 ? (double)Realizado / Meta * 100 : 0;
}
