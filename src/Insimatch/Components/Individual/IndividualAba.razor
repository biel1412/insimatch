@* Aba "Resultado individual" — editor + apresentação (funcionamento inalterado) *@
@inject ArmazenamentoService Armazenamento
@inject IJSRuntime JS

<PageTitle>insiTalent · @(Atual?.Nome ?? "Resultado individual")</PageTitle>

    <aside class="lateral">
        <div class="marca">
            <div class="marca-logo">insi<span>Talent</span></div>
            <div class="marca-sub">Resultado individual</div>
        </div>

        <div class="abas">
            <button class="@(Aba == "dados" ? "ativa" : "")" @onclick='() => { Aba = "dados"; }'>Colaborador</button>
            <button class="@(Aba == "lista" ? "ativa" : "")" @onclick='() => { Aba = "lista"; }'>Lista (@Lista.Count)</button>
        </div>

        @if (Atual is not null && Aba == "dados")
        {
            <div class="form">
                <label>Nome do colaborador
                    <input @bind="Atual.Nome" @bind:event="oninput" @bind:after="SalvarAsync" placeholder="Ex.: Maria Souza" />
                </label>
                <div class="form-2">
                    <label>Equipe
                        <input @bind="Atual.Equipe" @bind:event="oninput" @bind:after="SalvarAsync" placeholder="Ex.: Atendimento" />
                    </label>
                    <label>Mês
                        <input type="month" value="@Atual.Mes" @onchange="AlterarMesAsync" />
                    </label>
                </div>

                <div class="form-grupo">Produção</div>
                <div class="form-2">
                    <label>Volume do mês
                        <input type="number" min="0" @bind="Atual.Volume" @bind:event="oninput" @bind:after="SalvarAsync" />
                    </label>
                    <label>Dias trabalhados
                        <input type="number" min="0" max="31" @bind="Atual.DiasConsiderados" @bind:event="oninput" @bind:after="SalvarAsync" />
                    </label>
                </div>
                <div class="form-2">
                    <label>Meta Pro (por dia)
                        <input type="number" min="0" step="1" placeholder="Ex.: 150" @bind="Atual.MetaPro" @bind:event="oninput" @bind:after="SalvarAsync" />
                    </label>
                    <label>Meta Premium (por dia)
                        <input type="number" min="0" step="1" placeholder="Ex.: 180" @bind="Atual.MetaPremium" @bind:event="oninput" @bind:after="SalvarAsync" />
                    </label>
                </div>
                <div class="calculado">Média diária (calculada): <strong>@Atual.MediaDiaria.ToString("N1")/dia</strong> · @Avaliacao.RotuloVolume(Atual)</div>

                <div class="form-grupo">Qualidade</div>
                <label>Meta de qualidade (%)
                    <input type="number" min="0" max="100" step="0.01" placeholder="99,94" @bind="Atual.MetaQualidade" @bind:event="oninput" @bind:after="SalvarAsync" />
                </label>
                <div class="form-2">
                    <label>Desvios internos
                        <input type="number" min="0" @bind="Atual.DesviosInternos" @bind:event="oninput" @bind:after="SalvarAsync" />
                    </label>
                    <label>Desvios externos
                        <input type="number" min="0" @bind="Atual.DesviosExternos" @bind:event="oninput" @bind:after="SalvarAsync" />
                    </label>
                </div>

                <div class="calculado">Qualidade (calculada): <strong>@Atual.Qualidade.ToString("N2")%</strong> · @Avaliacao.RotuloQualidade(Atual)
                    <br /><small>Máximo de desvios para @Avaliacao.MetaQualTexto(Atual): @Avaliacao.DesviosPermitidos(Atual)</small></div>

                <div class="form-grupo">
                    Parecer
                    <button class="link" @onclick="() => { MostrarSugestoes = !MostrarSugestoes; }">✨ Gerar sugestão</button>
                </div>
                @if (MostrarSugestoes)
                {
                    <SugestoesParecer Opcoes="@Avaliacao.ListarSugestoes(Atual)" OnEscolher="UsarSugestaoAsync" OnFechar="() => { MostrarSugestoes = false; }" />
                }
                <textarea rows="7" @bind="Atual.Parecer" @bind:event="oninput" @bind:after="SalvarAsync"
                          placeholder="Clique em “Gerar sugestão” para escolher um modelo, ou escreva o seu. Vazio = sem parecer na apresentação."></textarea>
                @if (!string.IsNullOrWhiteSpace(Atual.Parecer))
                {
                    <button class="link alinhar-dir" @onclick="LimparParecerAsync">Limpar parecer</button>
                }

                <div class="acoes">
                    <button class="btn" @onclick="NovoAsync">+ Novo</button>
                    <button class="btn" @onclick="DuplicarAsync">Duplicar</button>
                    <button class="btn perigo" @onclick="ExcluirAsync">Excluir</button>
                </div>
            </div>
        }
        else if (Aba == "lista")
        {
            <div class="form">
                <input class="busca" placeholder="Buscar por nome, equipe ou mês…" @bind="Busca" @bind:event="oninput" />
                <ul class="lista">
                    @foreach (var c in Filtrados)
                    {
                        var st = Avaliacao.Geral(c);
                        <li class="@(c.Id == Atual?.Id ? "sel" : "")" @onclick="() => Selecionar(c)">
                            <span class="mini-avatar @Avaliacao.Classe(st)">@c.Iniciais</span>
                            <span class="lista-txt">
                                <strong>@(string.IsNullOrWhiteSpace(c.Nome) ? "(sem nome)" : c.Nome)</strong>
                                <small>@c.Equipe @(string.IsNullOrWhiteSpace(c.Equipe) ? "" : "·") @c.MesPorExtenso</small>
                            </span>
                        </li>
                    }
                </ul>
                <div class="acoes">
                    <button class="btn" @onclick="NovoAsync">+ Novo</button>
                </div>

                <div class="form-grupo">Importar / exportar</div>
                <label class="btn arquivo">
                    Importar planilha (.csv)
                    <InputFile OnChange="ImportarAsync" accept=".csv,text/csv" />
                </label>
                @if (!string.IsNullOrEmpty(Mensagem))
                {
                    <div class="calculado">@Mensagem</div>
                }
                <div class="acoes">
                    <button class="btn" @onclick="ExportarAsync">Exportar .csv</button>
                    <button class="btn" @onclick="BaixarModeloAsync">Baixar modelo</button>
                </div>
                <p class="dica">Colunas: Nome; Equipe; Mes (aaaa-mm); Volume; MetaPro; MetaPremium (metas por dia); DiasConsiderados; DesviosInternos; DesviosExternos; Parecer. A qualidade é calculada.
                    Os dados ficam salvos apenas neste navegador.</p>
            </div>
        }
    </aside>

    <main class="principal">
        <div class="barra-topo">
            @if (Lista.Count > 1)
            {
                <div class="navegacao">
                    <button class="icone" title="Anterior" @onclick="() => Mover(-1)">‹</button>
                    <span>@(IndiceAtual + 1) de @Lista.Count</span>
                    <button class="icone" title="Próximo" @onclick="() => Mover(1)">›</button>
                </div>
            }
            <div class="espaco"></div>
            @Ferramentas
        </div>

        @if (Atual is not null)
        {
            @switch (Modelo)
            {
                case "graficos":
                    <DashboardGraficos C="Atual" />
                    break;
                case "placar":
                    <DashboardPlacar C="Atual" />
                    break;
                case "foco":
                    <DashboardFoco C="Atual" />
                    break;
                case "mosaico":
                    <DashboardMosaico C="Atual" />
                    break;
                default:
                    <Dashboard C="Atual" />
                    break;
            }
        }
        else
        {
            <div class="vazio">Carregando…</div>
        }
    </main>

@code {
    [Parameter] public bool Apresentacao { get; set; }
    [Parameter] public string Modelo { get; set; } = "cartoes";
    [Parameter] public RenderFragment? Ferramentas { get; set; }
    [CascadingParameter] public RelatorioHost? Relatorio { get; set; }

    protected override void OnInitialized()
    {
        // Diz à barra de ferramentas como gerar o relatório do que está aberto nesta aba
        if (Relatorio is not null) Relatorio.Gerar = () => Atual is null ? null : Relatorios.De(Atual);
    }

    private List<Colaborador> Lista = new();
    private Colaborador? Atual;
    private string Aba = "dados";
    private string Busca = "";
    private string Mensagem = "";


    private int IndiceAtual => Atual is null ? 0 : Math.Max(0, Lista.IndexOf(Atual));

    private IEnumerable<Colaborador> Filtrados => string.IsNullOrWhiteSpace(Busca)
        ? Lista
        : Lista.Where(c => $"{c.Nome} {c.Equipe} {c.MesPorExtenso} {c.Mes}"
            .Contains(Busca, StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Lista = await Armazenamento.CarregarColaboradoresAsync();
        // Limpa pareceres automáticos antigos (informais); vazio = parecer formal automático
        var limpou = false;
        foreach (var c in Lista.Where(x => Avaliacao.ParecerAntigoAutomatico(x.Parecer)))
        {
            c.Parecer = "";
            limpou = true;
        }
        if (limpou) await SalvarAsync();
        if (Lista.Count == 0)
        {
            Lista.Add(new Colaborador
            {
                Nome = "Maria Souza",
                Equipe = "Atendimento",
                Volume = 3410,
                MetaPro = 150,
                MetaPremium = 180,
                DiasConsiderados = 22,
                DesviosInternos = 1,
                DesviosExternos = 0
            });
            await SalvarAsync();
        }
        Atual = Lista[0];
        StateHasChanged();
    }

    private async Task AlterarMesAsync(ChangeEventArgs e)
    {
        if (Atual is null) return;
        var v = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(v)) Atual.Mes = v;
        await SalvarAsync();
    }

    private Task SalvarAsync() => Armazenamento.SalvarColaboradoresAsync(Lista);

    private void Selecionar(Colaborador c)
    {
        Atual = c;
        if (!Apresentacao) Aba = "dados";
    }

    private void Mover(int passo)
    {
        if (Lista.Count == 0) return;
        var i = (IndiceAtual + passo + Lista.Count) % Lista.Count;
        Atual = Lista[i];
    }

    private async Task NovoAsync()
    {
        var c = new Colaborador { Mes = Atual?.Mes ?? DateTime.Today.ToString("yyyy-MM"), Equipe = Atual?.Equipe ?? "", MetaQualidade = Atual?.MetaQualidade ?? 99.94m };
        Lista.Add(c);
        Atual = c;
        Aba = "dados";
        await SalvarAsync();
    }

    private async Task DuplicarAsync()
    {
        if (Atual is null) return;
        var c = Atual.Clonar();
        c.Id = Guid.NewGuid().ToString("N");
        c.Nome = Atual.Nome + " (cópia)";
        Lista.Insert(Lista.IndexOf(Atual) + 1, c);
        Atual = c;
        await SalvarAsync();
    }

    private async Task ExcluirAsync()
    {
        if (Atual is null) return;
        var i = Lista.IndexOf(Atual);
        Lista.Remove(Atual);
        if (Lista.Count == 0) Lista.Add(new Colaborador());
        Atual = Lista[Math.Clamp(i, 0, Lista.Count - 1)];
        await SalvarAsync();
    }

    private bool MostrarSugestoes;

    private async Task UsarSugestaoAsync(string texto)
    {
        if (Atual is null) return;
        Atual.Parecer = texto;
        MostrarSugestoes = false;
        await SalvarAsync();
    }

    private async Task LimparParecerAsync()
    {
        if (Atual is null) return;
        Atual.Parecer = "";
        await SalvarAsync();
    }

    private async Task ImportarAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var leitor = new StreamReader(e.File.OpenReadStream(5 * 1024 * 1024));
            var texto = await leitor.ReadToEndAsync();
            var novos = ArmazenamentoService.LerCsv(texto);
            if (novos.Count == 0)
            {
                Mensagem = "Nenhum colaborador encontrado no arquivo. Confira o cabeçalho.";
                return;
            }
            // Remove o registro vazio inicial, se houver
            Lista.RemoveAll(c => string.IsNullOrWhiteSpace(c.Nome) && c.Volume == 0);
            Lista.AddRange(novos);
            Atual = novos[0];
            Mensagem = $"{novos.Count} colaborador(es) importado(s).";
            await SalvarAsync();
        }
        catch (Exception ex)
        {
            Mensagem = "Não foi possível ler o arquivo: " + ex.Message;
        }
    }

    private async Task ExportarAsync() =>
        await JS.InvokeVoidAsync("insimatch.baixar", "insitalent-individual.csv", ArmazenamentoService.GerarCsv(Lista));

    private async Task BaixarModeloAsync() =>
        await JS.InvokeVoidAsync("insimatch.baixar", "insitalent-modelo-individual.csv", ArmazenamentoService.ModeloCsv());
}
