@* Modelo "Placar" do resultado do time *@
@{ var st = AvaliacaoTime.Geral(T); }
<PlacarLayout Linhas="@Linhas" Criterios="@Criterios" Status="st" VereditoValor="@Avaliacao.RotuloGeral(st)">
    <Superior><TimeCabecalho T="T" /></Superior>
    <Inferior><TimeParecer T="T" /></Inferior>
</PlacarLayout>

@code {
    [Parameter, EditorRequired] public ResultadoTime T { get; set; } = default!;

    private IReadOnlyList<LinhaPlacar> Linhas => new[]
    {
        new LinhaPlacar("", Grupo: "Volume"),
        new LinhaPlacar("Volume atingido", T.VolumeAtingido.ToString("N0"), null,
            T.MetaVolume > 0 ? $"meta {T.MetaVolume:N0}" : "—",
            AvaliacaoTime.StatusVolume(T), AvaliacaoTime.RotuloVolume(T)),
        new LinhaPlacar("Atingimento", T.Atingimento.ToString("N1"), "%", "≥ 100%",
            AvaliacaoTime.StatusVolume(T), AvaliacaoTime.RotuloVolume(T)),
        new LinhaPlacar("Diferença para a meta", (T.Diferenca >= 0 ? "+" : "") + T.Diferenca.ToString("N0")),
        new LinhaPlacar("", Grupo: "Qualidade"),
        new LinhaPlacar("Qualidade do mês", T.Qualidade.ToString("N2"), "%", $"≥ {T.MetaQualidade:N2}%",
            AvaliacaoTime.StatusQualidade(T), AvaliacaoTime.RotuloQualidade(T)),
        new LinhaPlacar("Desvios internos", T.DesviosInternos.ToString()),
        new LinhaPlacar("Desvios externos", T.DesviosExternos.ToString()),
        new LinhaPlacar("Total de desvios", T.TotalDesvios.ToString())
    };

    private IReadOnlyList<Criterio> Criterios => new[]
    {
        new Criterio($"Qualidade na meta (≥ {T.MetaQualidade:N2}%)", AvaliacaoTime.QualidadeOk(T)),
        new Criterio("Volume na meta ou próximo (≥ 90%)", AvaliacaoTime.VolumeProximo(T)),
        new Criterio("Meta de volume atingida (≥ 100%)", AvaliacaoTime.VolumeOk(T))
    };
}
