@* Modelo "Foco" do resultado do time *@
<FocoLayout Indicadores="@Principais" Secundarios="@Outros">
    <Superior><TimeCabecalho T="T" /></Superior>
    <Inferior><TimeParecer T="T" /></Inferior>
</FocoLayout>

@code {
    [Parameter, EditorRequired] public ResultadoTime T { get; set; } = default!;

    private IReadOnlyList<Indicador> Principais => new[]
    {
        new Indicador("Atingimento do volume", T.Atingimento.ToString("N0"), "%", AvaliacaoTime.StatusVolume(T),
            AvaliacaoTime.RotuloVolume(T), $"{T.VolumeAtingido:N0} de {T.MetaVolume:N0}"),
        new Indicador("Qualidade do mês", T.Qualidade.ToString("N2"), "%", AvaliacaoTime.StatusQualidade(T),
            AvaliacaoTime.RotuloQualidade(T), $"meta ≥ {T.MetaQualidade:N2}%"),
        new Indicador("Total de desvios", T.TotalDesvios.ToString(), null, Status.Neutro, null,
            $"{T.DesviosInternos} internos · {T.DesviosExternos} externos")
    };

    private IReadOnlyList<Indicador> Outros => new[]
    {
        new Indicador("Volume atingido", T.VolumeAtingido.ToString("N0")),
        new Indicador("Meta de volume", T.MetaVolume.ToString("N0")),
        new Indicador("Desvios internos", T.DesviosInternos.ToString()),
        new Indicador("Desvios externos", T.DesviosExternos.ToString())
    };
}
