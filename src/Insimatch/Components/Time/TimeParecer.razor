@* Parecer do time *@
<ParecerBloco Texto="@(string.IsNullOrWhiteSpace(T.Parecer) ? AvaliacaoTime.GerarParecer(T) : T.Parecer)"
              Status="AvaliacaoTime.Geral(T)"
              Assinatura="@(string.IsNullOrWhiteSpace(T.Nome) ? "insiTalent" : T.Nome)"
              Periodo="@T.MesPorExtenso" />

@code {
    [Parameter, EditorRequired] public ResultadoTime T { get; set; } = default!;
}
