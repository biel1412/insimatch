@* Modelo "Cartões" do resultado do time *@
@{
    var sVol = AvaliacaoTime.StatusVolume(T);
    var sQual = AvaliacaoTime.StatusQualidade(T);
    var frac = (double)Math.Clamp(T.Atingimento / 100m, 0, 1);
    const double r = 78;
    var circ = 2 * Math.PI * r;
}

<section class="painel modelo-time">
    <TimeCabecalho T="T" />

    <div class="secao-titulo"><span>01</span> Volume</div>
    <div class="grade grade-prod">
        <article class="cartao destaque @Avaliacao.Classe(sVol)">
            <div class="cartao-topo">
                <span class="cartao-rotulo">Volume atingido × meta</span>
                <span class="chip">@AvaliacaoTime.RotuloVolume(T)</span>
            </div>
            <div class="anel-linha">
                <div class="anel">
                    <svg viewBox="0 0 200 200">
                        <defs>
                            <linearGradient id="anel-time" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" class="g1" /><stop offset="100%" class="g2" />
                            </linearGradient>
                        </defs>
                        <circle cx="100" cy="100" r="78" class="anel-trilho" />
                        <circle cx="100" cy="100" r="78" class="anel-valor" stroke="url(#anel-time)"
                                stroke-dasharray="@F(circ * frac) @F(circ)" transform="rotate(-90 100 100)" />
                    </svg>
                    <div class="anel-texto">
                        <strong>@T.Atingimento.ToString("N0")<small>%</small></strong>
                        <span>da meta</span>
                    </div>
                </div>
                <div class="anel-dados">
                    <div><span>Volume atingido</span><strong>@T.VolumeAtingido.ToString("N0")</strong></div>
                    <div><span>Meta de volume</span><strong>@(T.MetaVolume > 0 ? T.MetaVolume.ToString("N0") : "—")</strong></div>
                    @if (T.MetaVolume > 0)
                    {
                        <div class="@(T.Diferenca >= 0 ? "pos" : "neg")">
                            <span>@(T.Diferenca >= 0 ? "Acima da meta" : "Faltam para a meta")</span>
                            <strong>@(T.Diferenca >= 0 ? "+" : "")@T.Diferenca.ToString("N0")</strong>
                        </div>
                    }
                </div>
            </div>
        </article>

        <article class="cartao cartao-medidor @Avaliacao.Classe(sQual)">
            <div class="cartao-topo">
                <span class="cartao-rotulo">Qualidade do mês</span>
                <span class="chip">@AvaliacaoTime.RotuloQualidade(T)</span>
            </div>
            <Medidor Valor="T.Qualidade" Meta="T.MetaQualidade" StatusAtual="sQual" />
        </article>
    </div>

    <div class="secao-titulo"><span>02</span> Desvios</div>
    <div class="grade grade-3">
        <article class="cartao neutro">
            <div class="cartao-rotulo">Desvios internos</div>
            <div class="numero">@T.DesviosInternos</div>
            <div class="rodape"><span>identificados internamente</span></div>
        </article>
        <article class="cartao neutro">
            <div class="cartao-rotulo">Desvios externos</div>
            <div class="numero">@T.DesviosExternos</div>
            <div class="rodape"><span>apontados externamente</span></div>
        </article>
        <article class="cartao neutro">
            <div class="cartao-rotulo">Total de desvios</div>
            <div class="numero">@T.TotalDesvios</div>
            <div class="rodape"><span>internos + externos</span></div>
        </article>
    </div>

    <div class="secao-titulo"><span>03</span> Parecer</div>
    <TimeParecer T="T" />
</section>

@code {
    [Parameter, EditorRequired] public ResultadoTime T { get; set; } = default!;

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
