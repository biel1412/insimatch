@* Cabeçalho e parecer do resultado do time *@
@{ var st = AvaliacaoTime.Geral(T); }
<Topo RotuloSup="Resultado do time"
      Titulo="@(string.IsNullOrWhiteSpace(T.Nome) ? "Nome do time" : T.Nome)"
      Info="@(new[] { T.MesPorExtenso })"
      Status="st"
      SeloValor="@Avaliacao.RotuloGeral(st)">
    <Icone>
        <svg viewBox="0 0 24 24" class="ico-avatar"><circle cx="9" cy="8" r="3.2" /><circle cx="17" cy="9.5" r="2.4" /><path d="M2.8 19c.6-3.3 3.2-5.2 6.2-5.2s5.6 1.9 6.2 5.2" /><path d="M15.2 14.3c2.6-.3 5 1.2 5.8 4.7" /></svg>
    </Icone>
</Topo>

@code {
    [Parameter, EditorRequired] public ResultadoTime T { get; set; } = default!;
}
