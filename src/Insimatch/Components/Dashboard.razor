@* Painel de apresentação do resultado individual — pensado para compartilhar a tela no Teams *@
@{
    var sVol = Avaliacao.StatusVolume(C);
    var sQual = Avaliacao.StatusQualidade(C);
    var sGeral = Avaliacao.Geral(C);
    // Escala da barra: a maior entre as metas e o realizado
    var escala = Math.Max(Math.Max(C.MetaPro, C.MetaPremium), C.Volume);
    if (escala <= 0) escala = 1;
    var temMeta = C.MetaPro > 0 || C.MetaPremium > 0;
}

<section class="painel">
    <header class="painel-topo">
        <div class="pessoa">
            <div class="avatar @Avaliacao.Classe(sGeral)">@C.Iniciais</div>
            <div>
                <div class="rotulo-sup">Resultado individual</div>
                <h1>@(string.IsNullOrWhiteSpace(C.Nome) ? "Nome do colaborador" : C.Nome)</h1>
                <div class="pessoa-info">
                    @if (!string.IsNullOrWhiteSpace(C.Equipe))
                    {
                        <span>@C.Equipe</span><span class="ponto">•</span>
                    }
                    <span>@C.MesPorExtenso</span>
                </div>
            </div>
        </div>
        <div class="selo @Avaliacao.Classe(sGeral)">
            <span class="selo-luz"></span>
            <div>
                <div class="selo-rotulo">Resultado geral</div>
                <div class="selo-valor">@Avaliacao.RotuloGeral(sGeral)</div>
            </div>
        </div>
    </header>

    <div class="secao-titulo"><span>01</span> Produção</div>
    <div class="grade grade-prod">
        <article class="cartao destaque @Avaliacao.Classe(sVol)">
            <div class="cartao-topo">
                <span class="cartao-rotulo">Volume do mês</span>
                <span class="chip">@Avaliacao.RotuloVolume(C)</span>
            </div>
            <div class="numero">@C.Volume.ToString("N0")</div>

            @if (temMeta)
            {
                <div class="barra-metas">
                    <div class="barra"><div style="width:@Pct((double)C.Volume / escala)"></div></div>
                    @if (C.MetaPro > 0)
                    {
                        <span class="marco @(C.Volume >= C.MetaPro ? "ok" : "")" style="left:@Pct((double)C.MetaPro / escala)"><i>Pro</i></span>
                    }
                    @if (C.MetaPremium > 0)
                    {
                        <span class="marco @(C.Volume >= C.MetaPremium ? "ok" : "")" style="left:@Pct((double)C.MetaPremium / escala)"><i>Premium</i></span>
                    }
                </div>

                <div class="metas-linhas">
                    @if (C.MetaPro > 0)
                    {
                        <LinhaMeta Nome="Meta Pro" Meta="C.MetaPro" Realizado="C.Volume" />
                    }
                    @if (C.MetaPremium > 0)
                    {
                        <LinhaMeta Nome="Meta Premium" Meta="C.MetaPremium" Realizado="C.Volume" />
                    }
                </div>
            }
            else
            {
                <div class="rodape"><span>Informe a meta Pro e a meta Premium no editor para comparar.</span></div>
            }
        </article>

        <div class="prod-lado">
            <article class="cartao neutro">
                <div class="cartao-topo"><span class="cartao-rotulo">Média diária</span></div>
                <div class="numero">@C.MediaDiaria.ToString("N1")<small>/dia</small></div>
                <div class="rodape"><span>volume ÷ dias considerados</span></div>
            </article>

            <article class="cartao neutro">
                <div class="cartao-topo"><span class="cartao-rotulo">Dias considerados</span></div>
                <div class="numero">@C.DiasConsiderados<small>dias</small></div>
                <div class="dias">
                    @for (var i = 0; i < Math.Min(C.DiasConsiderados, 31); i++)
                    {
                        <span></span>
                    }
                </div>
            </article>
        </div>
    </div>

    <div class="secao-titulo"><span>02</span> Qualidade</div>
    <div class="grade grade-qual">
        <article class="cartao cartao-medidor @Avaliacao.Classe(sQual)">
            <div class="cartao-topo">
                <span class="cartao-rotulo">Qualidade</span>
                <span class="chip">@Avaliacao.RotuloQualidade(C)</span>
            </div>
            <Medidor Valor="C.Qualidade" Meta="Avaliacao.QualidadeIdeal" StatusAtual="sQual" />
        </article>

        <div class="desvios">
            <article class="cartao neutro">
                <div class="cartao-topo"><span class="cartao-rotulo">Desvios internos</span></div>
                <div class="numero">@C.DesviosInternos</div>
                <div class="rodape"><span>identificados internamente</span></div>
            </article>

            <article class="cartao neutro">
                <div class="cartao-topo"><span class="cartao-rotulo">Desvios externos</span></div>
                <div class="numero">@C.DesviosExternos</div>
                <div class="rodape"><span>apontados externamente</span></div>
            </article>
        </div>
    </div>

    <div class="secao-titulo"><span>03</span> Parecer</div>
    <article class="cartao parecer @Avaliacao.Classe(sGeral)">
        <div class="aspas">“</div>
        <p>@(string.IsNullOrWhiteSpace(C.Parecer) ? Avaliacao.GerarParecer(C) : C.Parecer)</p>
        <div class="parecer-assinatura">
            <span>@(string.IsNullOrWhiteSpace(C.Equipe) ? "Insimatch" : C.Equipe)</span>
            <span>@C.MesPorExtenso</span>
        </div>
    </article>
</section>

@code {
    [Parameter, EditorRequired] public Colaborador C { get; set; } = default!;

    private static string Pct(double v) =>
        (Math.Clamp(v, 0, 1) * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";
}
