@* Modelo "Foco" da atualização de fila *@
<FocoLayout Indicadores="@Principais" Secundarios="@Outros">
    <Superior><FilaCabecalho F="F" /></Superior>
    <Inferior><FilaParecer F="F" /></Inferior>
</FocoLayout>

@code {
    [Parameter, EditorRequired] public AtualizacaoFila F { get; set; } = default!;

    private IReadOnlyList<Indicador> Principais => new[]
    {
        new Indicador("Centralizada · dia anterior", F.Centralizada.ToString("N0"), null, AvaliacaoFila.StatusFila(F.Centralizada),
            AvaliacaoFila.RotuloFila(F.Centralizada), $"de {AvaliacaoFila.Fluxos(F.CentralizadaTotal)} na fila"),
        new Indicador("Autorizar · dia anterior", F.Autorizar.ToString("N0"), null, AvaliacaoFila.StatusFila(F.Autorizar),
            AvaliacaoFila.RotuloFila(F.Autorizar), $"de {AvaliacaoFila.Fluxos(F.AutorizarTotal)} na fila")
    };

    private IReadOnlyList<Indicador> Outros => new[]
    {
        new Indicador("Centralizada · na fila", F.CentralizadaTotal.ToString("N0"), $" ({AvaliacaoFila.PaginasTexto(F.CentralizadaTotal)})"),
        new Indicador("Autorizar · na fila", F.AutorizarTotal.ToString("N0"), $" ({AvaliacaoFila.PaginasTexto(F.AutorizarTotal)})"),
        new Indicador("Dia anterior · total", F.Total.ToString("N0"))
    };
}
