@* Modelo "Placar" da atualização de fila *@
@{ var st = AvaliacaoFila.Geral(F); }
<PlacarLayout Linhas="@Linhas" Criterios="@Criterios" Status="st"
              VereditoRotulo="Situação das filas" VereditoValor="@AvaliacaoFila.RotuloGeral(F)">
    <Superior><FilaCabecalho F="F" /></Superior>
    <Inferior><FilaParecer F="F" /></Inferior>
</PlacarLayout>

@code {
    [Parameter, EditorRequired] public AtualizacaoFila F { get; set; } = default!;

    private IReadOnlyList<LinhaPlacar> Linhas => new[]
    {
        new LinhaPlacar("", Grupo: "Centralizada"),
        new LinhaPlacar("Fluxos na fila", F.CentralizadaTotal.ToString("N0"), null, AvaliacaoFila.PaginasTexto(F.CentralizadaTotal)),
        new LinhaPlacar("Com data do dia anterior", F.Centralizada.ToString("N0"), null, AvaliacaoFila.PaginasTexto(F.Centralizada),
            AvaliacaoFila.StatusFila(F.Centralizada), AvaliacaoFila.RotuloFila(F.Centralizada)),
        new LinhaPlacar("", Grupo: "Autorizar"),
        new LinhaPlacar("Fluxos na fila", F.AutorizarTotal.ToString("N0"), null, AvaliacaoFila.PaginasTexto(F.AutorizarTotal)),
        new LinhaPlacar("Com data do dia anterior", F.Autorizar.ToString("N0"), null, AvaliacaoFila.PaginasTexto(F.Autorizar),
            AvaliacaoFila.StatusFila(F.Autorizar), AvaliacaoFila.RotuloFila(F.Autorizar)),
        new LinhaPlacar("", Grupo: "Consolidado"),
        new LinhaPlacar("Fluxos nas duas filas", F.TotalNaFila.ToString("N0")),
        new LinhaPlacar("Com data do dia anterior", F.Total.ToString("N0"), null, "—",
            AvaliacaoFila.Geral(F), AvaliacaoFila.RotuloGeral(F))
    };

    private IReadOnlyList<Criterio> Criterios => new[]
    {
        new Criterio("Centralizada: até 1 página do dia anterior", AvaliacaoFila.StatusFila(F.Centralizada) is Status.Excelente or Status.Bom),
        new Criterio("Autorizar: até 1 página do dia anterior", AvaliacaoFila.StatusFila(F.Autorizar) is Status.Excelente or Status.Bom),
        new Criterio("Nenhuma fila com acúmulo (acima de 3 páginas)", AvaliacaoFila.Geral(F) != Status.Critico)
    };
}
