@* Páginas da fila (15 fluxos cada). A parte com data do dia anterior aparece destacada. *@
@{
    var paginas = AvaliacaoFila.Paginas(Fluxos);
    var mostradas = Math.Min(paginas, Maximo);
    var anterior = Math.Min(Destaque, Fluxos);
}
<div class="paginas">
    @if (paginas == 0)
    {
        <div class="pagina vazia" title="Fila vazia"><span>✓</span></div>
    }
    @for (var i = 0; i < mostradas; i++)
    {
        var inicio = i * AvaliacaoFila.FluxosPorPagina;
        var nessa = Math.Min(Fluxos - inicio, AvaliacaoFila.FluxosPorPagina);
        var antNessa = Math.Clamp(anterior - inicio, 0, nessa);
        <div class="pagina" title="Página @(i + 1): @nessa fluxos, @antNessa do dia anterior">
            <div class="pagina-fill" style="height:@P(nessa)"></div>
            <div class="pagina-anterior" style="height:@P(antNessa)"></div>
            <span>@(i + 1)</span>
        </div>
    }
    @if (paginas > mostradas)
    {
        <div class="pagina mais"><span>+@(paginas - mostradas)</span></div>
    }
</div>
@if (paginas > 0)
{
    <div class="paginas-legenda">
        <span><i class="leg-ant"></i>dia anterior</span>
        <span><i class="leg-dia"></i>demais fluxos</span>
    </div>
}

@code {
    [Parameter] public int Fluxos { get; set; }
    /// <summary>Quantos dos fluxos têm data do dia anterior (preenchidos primeiro, pois são os mais antigos).</summary>
    [Parameter] public int Destaque { get; set; }
    [Parameter] public int Maximo { get; set; } = 12;

    private static string P(int n) =>
        (n * 100.0 / AvaliacaoFila.FluxosPorPagina).ToString("0.#", CultureInfo.InvariantCulture) + "%";
}
