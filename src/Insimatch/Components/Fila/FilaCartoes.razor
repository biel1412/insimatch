@* Modelo "Cartões" da atualização de fila *@
<section class="painel modelo-fila">
    <FilaCabecalho F="F" />

    <div class="secao-titulo"><span>01</span> Filas</div>
    <div class="grade fila-grade">
        @foreach (var (nome, total, anterior) in new[] { ("Centralizada", F.CentralizadaTotal, F.Centralizada), ("Autorizar", F.AutorizarTotal, F.Autorizar) })
        {
            var st = AvaliacaoFila.StatusFila(anterior);
            <article class="cartao destaque @Avaliacao.Classe(st)">
                <div class="cartao-topo">
                    <span class="cartao-rotulo fila-nome">@nome</span>
                    <span class="chip">@AvaliacaoFila.RotuloFila(anterior)</span>
                </div>
                <div class="fila-numeros">
                    <div>
                        <span class="fila-rotulo">Fluxos na fila</span>
                        <div class="numero">@total.ToString("N0")</div>
                        <span class="mudo">@AvaliacaoFila.PaginasTexto(total)</span>
                    </div>
                    <div class="fila-anterior">
                        <span class="fila-rotulo">Com data do dia anterior</span>
                        <div class="numero">@anterior.ToString("N0")</div>
                        <span class="mudo">@AvaliacaoFila.PaginasTexto(anterior)</span>
                    </div>
                </div>
                <FilaPaginas Fluxos="total" Destaque="anterior" />
            </article>
        }
    </div>

    <div class="secao-titulo"><span>02</span> Parecer</div>
    <FilaParecer F="F" />
</section>

@code {
    [Parameter, EditorRequired] public AtualizacaoFila F { get; set; } = default!;
}
